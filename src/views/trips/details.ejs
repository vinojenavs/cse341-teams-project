
<%- include('../partials/header') %>

<article class="route-detail">
    <div class="route-header">
        <div class="route-header-content">
            <h1 class="route-name">
                <%= details.departure %> to <%= details.destination %>
            </h1>

            <p class="route-description">
                <%= details.description || 'Enjoy your journey with us.' %>
            </p>
        </div>
    </div>

    <div class="route-info">
        <div class="info-grid">

            <div class="info-item">
                <span class="info-label">Departure</span>
                <span class="info-value">
                    <%= details.departure %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Destination</span>
                <span class="info-value">
                    <%= details.destination %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Departure Date</span>
                <span class="info-value">
                    <%= new Date(details.departureDate).toLocaleString() %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Arrival Date</span>
                <span class="info-value">
                    <%= new Date(details.arrivalDate).toLocaleString() %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Price</span>
                <span class="info-value">
                    ₦<%= Number(details.price).toLocaleString() %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Trip Status</span>
                <span class="info-value">
                    <%= details.status %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Available Seats</span>
                <span class="info-value">
                    <%= details.availableSeats %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Total Seats</span>
                <span class="info-value">
                    <%= details.totalSeats %>
                </span>
            </div>

        </div>

        <div class="route-stations">
            <h2>Your Journey</h2>

            <div class="stations">
                <div class="station">
                    <span class="station-label">From</span>
                    <span class="station-name">
                        <%= details.departure %>
                    </span>
                </div>

                <div class="station">
                    <span class="station-label">To</span>
                    <span class="station-name">
                        <%= details.destination %>
                    </span>
                </div>
            </div>
        </div>

        <!-- Schedules Section -->
        <section class="route-schedules">
            <h2>Trip Schedules</h2>

            <div class="schedule-filter">
                <label for="scheduleMonth">Select Month:</label>

                <select id="scheduleMonth">
                    <option value="">All Months</option>
                    <option value="1">January</option>
                    <option value="2">February</option>
                    <option value="3">March</option>
                    <option value="4">April</option>
                    <option value="5">May</option>
                    <option value="6">June</option>
                    <option value="7">July</option>
                    <option value="8">August</option>
                    <option value="9">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </select>
            </div>

            <div id="schedulesList">
                Loading schedules...
            </div>
        </section>

    </div>
</article>

<script>
    const tripId = '<%= details.id %>';

    const schedulesList = document.getElementById('schedulesList');
    const monthSelector = document.getElementById('scheduleMonth');

    async function loadSchedules(month = '') {
        schedulesList.textContent = 'Loading schedules...';

        try {
            let url = `/api/trips/${encodeURIComponent(tripId)}/schedules`;

            if (month) {
                url += `/month?month=${encodeURIComponent(month)}`;
            }

            const response = await fetch(url);

            if (!response.ok) {
                throw new Error('Failed to load schedules');
            }

            const schedules = await response.json();

            schedulesList.replaceChildren();

            if (!Array.isArray(schedules) || schedules.length === 0) {
                schedulesList.textContent = 'No schedules available for this month.';
                return;
            }

            schedules.forEach(schedule => {
                const scheduleItem = document.createElement('div');
                scheduleItem.className = 'schedule-item';

                const title = document.createElement('h3');
                title.textContent = schedule.title || 'Trip Schedule';

                const date = document.createElement('p');
                date.textContent = schedule.date
                    ? new Date(schedule.date).toLocaleDateString()
                    : '';

                const description = document.createElement('p');
                description.textContent = schedule.description || '';

                scheduleItem.append(title, date, description);
                schedulesList.appendChild(scheduleItem);
            });

        } catch (error) {
            console.error('Error loading schedules:', error);
            schedulesList.textContent = 'Unable to load schedules. Please try again.';
        }
    }

    loadSchedules();

    monthSelector.addEventListener('change', function () {
        loadSchedules(this.value);
    });
</script>

<%- include('../partials/footer') %>


