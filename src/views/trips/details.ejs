
<%- include('../partials/header') %>

<article class="route-detail">
    <div class="route-header">
        <div class="route-header-content">
            <h1 class="route-name">
                <%= details.departure %> to <%= details.destination %>
            </h1>

            <p class="route-description">
                <%= details.description || 'Enjoy your journey with us.' %>
            </p>
        </div>
    </div>

    <div class="route-info">
        <div class="info-grid">

            <div class="info-item">
                <span class="info-label">Departure</span>
                <span class="info-value">
                    <%= details.departure %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Destination</span>
                <span class="info-value">
                    <%= details.destination %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Departure Date</span>
                <span class="info-value">
                    <%= new Date(details.departureDate).toLocaleString() %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Arrival Date</span>
                <span class="info-value">
                    <%= new Date(details.arrivalDate).toLocaleString() %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Price</span>
                <span class="info-value">
                    ₦<%= Number(details.price).toLocaleString() %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Trip Status</span>
                <span class="info-value">
                    <%= details.status %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Available Seats</span>
                <span class="info-value">
                    <%= details.availableSeats %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Total Seats</span>
                <span class="info-value">
                    <%= details.totalSeats %>
                </span>
            </div>

        </div>

        <div class="route-stations">
            <h2>Your Journey</h2>

            <div class="stations">
                <div class="station">
                    <span class="station-label">From</span>
                    <span class="station-name">
                        <%= details.departure %>
                    </span>
                </div>

                <div class="station">
                    <span class="station-label">To</span>
                    <span class="station-name">
                        <%= details.destination %>
                    </span>
                </div>
            </div>
        </div>

    </div>
</article>

<%- include('../partials/footer') %>
